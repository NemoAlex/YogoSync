{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YogoSync",
  "version": "1.0.0",
  "identifier": "dev.yogosync.desktop",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "YogoSync",
        "width": 410,
        "height": 680,
        "minWidth": 380,
        "minHeight": 640,
        "maxWidth": 540,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": [
      "resources/*"
    ],
    "shortDescription": "让键盘点阵随 Codex 任务变化",
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
